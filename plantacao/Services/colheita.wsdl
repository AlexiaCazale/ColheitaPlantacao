<?xml version='1.0' encoding='UTF-8'?>

<definitions xmlns:SOAP-ENV="http://schemas.xmlsoap.org/soap/envelope/" 
    xmlns:xsd="http://www.w3.org/2001/XMLSchema" 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xmlns:SOAP-ENC="http://schemas.xmlsoap.org/soap/encoding/" 
    xmlns:tns="http://localhost/plantacao/services/ColheitaSOAP.class.php" 
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" 
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" 
    xmlns="http://schemas.xmlsoap.org/wsdl/" 
    targetNamespace="http://localhost/plantacao/services/ColheitaSOAP.class.php">

<types>
	<xsd:schema targetNamespace="http://localhost/plantacao/services/ColheitaSOAP.class.php">

	<!-- Lógica para o header de login -->
		<xsd:complexType name="dadosSecType">
			<xsd:sequence>
				<xsd:element name="email" type="xsd:string"/>
				<xsd:element name="senha" type="xsd:string"/>
			</xsd:sequence>
		</xsd:complexType>

		<xsd:element name="security" type="tns:dadosSecType"/>
				
		<xsd:complexType name="dadosTokType">
			<xsd:sequence>
				<xsd:element name="token" type="xsd:string"/>
			</xsd:sequence>
		</xsd:complexType>

		<xsd:element name="token" type="tns:dadosTokType"/>

	</xsd:schema>
</types>

<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->

<!-- Scurity e Token -->
<message name="security">
	<part name="sec" element="tns:security"/>
</message>
<message name="token">
	<part name="tok" element="tns:token"/>
</message>

<!-- Inserir Colheita -->
<message name="inserir_colheita_soapRequest">
   <part name="idarea" element="xsi:int"/> 
   <part name="idplantacao" element="xsi:int"/> 
   <part name="data_colheita" element="xsi:string"/> 
   <part name="unidade" element="xsi:int"/> 
   <part name="quantidade" element="xsi:string"/> 
</message>
<message name="inserir_colheita_soapResponse">
	<part name="retorno" type="xsi:string"/>
</message>

<!-- Login -->
<message name="loginRequest"/>
<message name="loginResponse">
	<part name="retorno" type="xsi:string"/>
</message>

<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->

<portType name="portType1">

	<operation name="inserir_colheita_soap">
		<documentation>Inserir Colheita</documentation>
		<input message="tns:inserir_colheita_soapRequest"/>
        <output message="tns:inserir_colheita_soapResponse"/>
	</operation>

	<operation name="login">
		<documentation>Autenticar usuário</documentation>
		<input message="loginRequest"/>
		<output message="loginResponse"/>
	</operation>

</portType>

<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->

<binding name="binding1" type="tns:portType1">
	<soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
	
	<operation name="inserir_colheita_soap">
		<soap:operation soapAction="http://localhost/plantacao/Services/ColheitaSOAP.class.php/inserir_colheita_soap"/>
		<input>
			<soap:body use="encode" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/" namespace="plantacao"/>
			<soap:header use="literal" message="tns:token" namespace="plantacao" part="tok"/>
		</input>
		<output>
			<soap:body use="encode" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/" namespace="plantacao"/>
		</output> 
	</operation>	

	<operation name="login">
		<soap:operation soapAction="http://localhost/plantacao/Services/ColheitaSOAP.class.php/login" style="rpc"/>
		<input>
			<soap:body use="encode" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/" namespace="plantacao"/>
			<soap:header use="literal" message="tns:security" namespace="plantacao" part="sec"/>
		</input>
		<output>
			<soap:body use="encode" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/" namespace="plantacao"/>
		</output>
	</operation>
	
</binding>

<service name="ColheitaSOAP">
	<port name="tns:portType1" binding="tns:binding1">
		<soap:address location="http://localhost/plantacao/Services/ColheitaSOAP.class.php"/>
	</port>
</service>

</definitions>